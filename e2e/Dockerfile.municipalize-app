FROM node:22-bookworm AS build

WORKDIR /app

COPY municipalize-app/package*.json ./municipalize-app/
RUN cd municipalize-app && npm ci

COPY municipalize-app/ ./municipalize-app/
RUN cd municipalize-app && npm run build -- --configuration development

FROM nginx:1.27-alpine

COPY e2e/nginx.municipalize-app.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/municipalize-app/dist/municipalize-app/browser /usr/share/nginx/html
