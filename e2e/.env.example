# URL do frontend iniciado para o QA. Não inclua tokens ou cookies aqui.
E2E_BASE_URL=http://localhost:5100

# Slug de um tenant de teste ou anonimizado disponível no ambiente.
E2E_TENANT_SLUG=

# O Playwright inicia o Angular por padrão. Defina false para usar um servidor já iniciado.
E2E_START_APP=true

# Use false somente para validar contra APIs reais e um tenant real de QA.
E2E_USE_API_FIXTURES=true

# QA integrado: nunca versionar valores reais neste arquivo.
E2E_TENANT_API_BASE_URL=
E2E_REAL_USER_EMAIL=
E2E_REAL_USER_PASSWORD=
E2E_LOGIN_WITH_API=false

# Encaminhamento opcional das URLs lógicas do Angular para portas dinâmicas.
E2E_ADMIN_API_PROXY_URL=http://localhost:3000
E2E_TENANT_API_PROXY_URL=http://localhost:8080
E2E_FRONTEND_PORT=5100
E2E_BACKEND_PORT=3080
E2E_ADMIN_API_PORT=3200
E2E_ADMIN_MONGO_PORT=27017
E2E_MSSQL_PORT=1433
E2E_KEYCLOAK_PORT=8180
E2E_APP_STAGE=development

# Bootstrap integrado: exigidos somente para criar/atualizar a conta no Keycloak
# e vinculá-la ao usuário do ms-main. Nunca versionar estes valores.
E2E_QA_BOOTSTRAP=true
E2E_KEYCLOAK_BASE_URL=http://localhost:8180
E2E_MSSQL_HOST=localhost
E2E_MSSQL_DATABASE=db-main
E2E_ADMIN_MONGODB_URI=mongodb://municipalize_admin:municipalize_admin_password@localhost:27017/municipalize_admin_development?authSource=admin
E2E_ADMIN_DATABASE_NAME=municipalize_admin_development

# O script Docker carrega este arquivo para o LiteLLM. Por padrão usa o arquivo
# local já mantido pelo Admin API; nunca versionar as chaves neste projeto.
E2E_LITELLM_ENV_FILE=../municipalize-admin-app/.env.litellm

# Opcional para desenvolvimento local: usa um LiteLLM já saudável no host em
# vez de iniciar outro. Em CI e no QA isolado, deixe vazio para usar o container.
E2E_LITELLM_BASE_URL=
